{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/cloudflare": { "entry": ["vitest.cloud.config.ts"] },
    // cloudflare:workers is a workerd runtime module, not an npm dependency.
    "packages/runtime": { "ignoreDependencies": ["cloudflare"] },
    "packages/renkin": {
      "entry": ["tests/fixtures/**/*.ts", "vitest.cloud.config.ts"]
    },
    ".": {
      "entry": [],
      "project": [],
      // Reserved compatible Effect test tooling; consuming packages will declare their own dependencies.
      "ignoreDependencies": ["effect", "@effect/vitest"]
    }
  }
}
