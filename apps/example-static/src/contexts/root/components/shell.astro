---
interface Props {
  title: string;
}
const _title = Astro.props.title;
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{_title}</title></head>
  <body><main><slot /></main></body>
</html>
<style is:global>
  :root { font-family: system-ui, sans-serif; color: #16312e; background: #f1f7f4; }
  main { max-width: 48rem; margin: 5rem auto; padding: 2rem; }
  h1 { font-size: clamp(2rem, 6vw, 4rem); line-height: 1.05; }
  p { line-height: 1.6; } a { color: #17665b; }
  code { background: #e0ede6; padding: .2rem .4rem; border-radius: .3rem; }
</style>
