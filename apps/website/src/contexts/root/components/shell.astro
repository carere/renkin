---
interface Props {
  title: string;
}
const _title = Astro.props.title;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{_title}</title></head><body><main><slot /></main></body></html>
<style is:global>
  :root { font-family: system-ui, sans-serif; color: #182b46; background: #f2f5fc; }
  main { max-width: 48rem; margin: 5rem auto; padding: 2rem; }
  h1 { font-size: clamp(2rem, 6vw, 4rem); line-height: 1.05; }
  p { line-height: 1.6; } a { color: #305fa6; } nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
</style>
