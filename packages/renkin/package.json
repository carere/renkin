{
  "name": "renkin",
  "version": "0.0.0",
  "private": false,
  "description": "Renkin public API and CLI for local and Cloudflare applications.",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test-support/*": "./tests/support/*",
    "#test-fixtures/*": "./tests/fixtures/*"
  },
  "exports": {
    ".": "./src/contexts/root/api.ts",
    "./cloudflare": "./src/contexts/root/cloudflare.ts",
    "./testing": "./src/contexts/root/testing.ts",
    "./worker": "./src/contexts/root/worker.ts",
    "./durable-object": "./src/contexts/root/durable-object.ts",
    "./workflow": "./src/contexts/root/workflow.ts",
    "./astro": "./src/contexts/root/astro.ts",
    "./vite": "./src/contexts/root/vite.ts"
  },
  "bin": {
    "renkin": "./src/contexts/root/cli/main.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "bun -e 'throw new Error(\"Source workspace is not the release artifact. Run bun moon run renkin:pack, then use the generated tarball.\")'"
  },
  "dependencies": {
    "@renkin/cloudflare": "workspace:*",
    "@renkin/cloudflare-sdk": "workspace:*",
    "@renkin/core": "workspace:*",
    "@renkin/runtime": "workspace:*",
    "@renkin/testing": "workspace:*",
    "@renkin/websites": "workspace:*"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@effect/vitest": "^4.0.0-rc.115",
    "@tanstack/solid-query": "^5.103.2",
    "@tanstack/solid-router": "^1.170.36",
    "@tanstack/solid-start": "^1.168.54",
    "astro": "^7.3.3",
    "aws4fetch": "^1.0.20",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "solid-js": "^1.9.15",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.115"
  }
}
